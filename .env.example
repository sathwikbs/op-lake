# ============================================================
# Data Platform - environment configuration
#
# This file is the single "multi-cloud switch surface". Every value that would
# change when moving from local -> AWS/Azure/GCP lives here.
#
# Usage:  cp .env.example .env   (then edit as needed)
# ============================================================

# ------------------------------------------------------------
# Component versions (bump in one place)
# ------------------------------------------------------------
UC_VERSION=v0.5.0
POSTGRES_VERSION=16
MINIO_VERSION=RELEASE.2025-04-08T15-41-24Z
MC_VERSION=RELEASE.2025-04-08T15-39-49Z
KEYCLOAK_VERSION=26.1

# Spark + lakehouse libraries.
#
# NOTE ON SPARK 4.2:
#   The Unity Catalog Spark connector 0.5.0 publishes STABLE Maven artifacts
#   only for Spark 4.0.x and 4.1.x. Spark 4.2 support currently exists only as
#   CI snapshots (unitycatalog PR #1518), not a released artifact. We therefore
#   pin the latest *supported* combo (Spark 4.1.0 + Delta 4.3.0 + UC 0.5.0).
#   When the 4.2 connector is released, bump the four values below and the
#   SPARK_MAJOR_MINOR (used to select the _4.x_ artifact names).
SPARK_VERSION=4.1.0
SPARK_MAJOR_MINOR=4.1
SCALA_VERSION=2.13
DELTA_VERSION=4.3.0
UC_SPARK_VERSION=0.5.0
HADOOP_AWS_VERSION=3.4.2

# ------------------------------------------------------------
# Storage - S3-compatible. Local uses MinIO.
#
# To target real cloud object storage:
#   AWS   : set S3_ENDPOINT= (empty) + real bucket/keys or IAM role
#   Azure : swap the Spark hadoop connector to hadoop-azure + abfss:// paths
#   GCS   : swap to the gcs-connector + gs:// paths
# ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
# Root credential: ADMIN PLANE ONLY (MinIO console + UC's STS vendor). NEVER hand
# it to the user/compute plane -- those get short-lived, path-scoped STS creds
# minted from their Keycloak identity (AssumeRoleWithWebIdentity).
MINIO_ROOT_PASSWORD=set-by-vault
S3_ENDPOINT=http://minio:9000
# No static object-store key in the compute plane: Spark reaches storage ONLY via
# UC credential vending (credScopedFs). Ingestion writes UC-managed tables through
# Spark, so nothing needs a direct MinIO key.
S3_REGION=us-east-1
LAKEHOUSE_BUCKET=lakehouse

# MinIO <-> Keycloak OIDC (STS AssumeRoleWithWebIdentity). MinIO trusts Keycloak
# JWTs and reads the `minio_policy` claim to attach hierarchical bucket/path
# policies -- Keycloak-governed MinIO access even though UC OSS can't do it.
MINIO_OIDC_CLIENT_ID=minio
MINIO_OIDC_CLIENT_SECRET=set-by-vault
MINIO_OIDC_CLAIM_NAME=minio_policy
MINIO_STS_DURATION_SECONDS=3600
# Permanent, bucket-scoped MinIO service account that Unity Catalog vends as its
# storage credential. NON-EXPIRING: UC loads it once at boot and vends it as-is,
# so UC never needs a restart or rotation to keep storage creds valid (the
# failure-free local posture). minio-init creates it, scoped to LAKEHOUSE_BUCKET;
# UC's RBAC still gates who may obtain it. LEAVE BLANK to fall back to STS
# mint-on-start (short-lived session minted at every UC start). In cloud, replace
# with per-request STS via UC's instance role.
UC_STORAGE_ACCESS_KEY=ucstorage
UC_STORAGE_SECRET_KEY=ucstorage-secret-change-me
# Lifetime of the MinIO STS session for the mint-on-start FALLBACK (used only
# when UC_STORAGE_ACCESS_KEY is blank). MinIO's 7-day max. In cloud, unused.
STS_DURATION_SECONDS=604800

# Admin-plane refresher (uc-cred-refresher): interval between scheduled UC
# restarts, each of which mints a fresh storage session. MUST be <
# STS_DURATION_SECONDS. Default 6 days vs the 7-day STS TTL.
UC_REFRESH_INTERVAL_SECONDS=518400
# Host Docker socket the refresher mounts to restart UC. Docker Desktop/Linux use
# /var/run/docker.sock; Colima uses ~/.colima/<profile>/docker.sock.
DOCKER_SOCK=/var/run/docker.sock

# ------------------------------------------------------------
# Postgres (Unity Catalog metadata + Dagster + Superset storage)
# ------------------------------------------------------------
POSTGRES_USER=platform
POSTGRES_PASSWORD=set-by-vault
UC_DB=ucdb
DAGSTER_DB=dagster
SUPERSET_DB=superset
# Keycloak identity store (durable, on the shared Postgres) -- survives recreate.
KEYCLOAK_DB=keycloak

# ------------------------------------------------------------
# Unity Catalog
# ------------------------------------------------------------
UC_URI=http://unitycatalog:8080
UC_CATALOG=analytics

# ------------------------------------------------------------
# Keycloak (OIDC identity provider)
# The client secret below MUST match infra/keycloak/realm-export.json
# and infra/unitycatalog/conf/server.properties.
# ------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=set-by-vault
KC_REALM=datalake
UC_OIDC_CLIENT_ID=unitycatalog
UC_OIDC_CLIENT_SECRET=set-by-vault

# ------------------------------------------------------------
# Automation identity (Dagster): the orchestration plane runs as this team
# SERVICE ACCOUNT (passwordless client-credentials), NOT Unity Catalog admin.
# Provision it once (requester needs the 'sa-creator' role):
#   python3 infra/iam/provision_service_account.py \
#     --requester-user engineer --requester-password engineer \
#     --name platform-automation --persona data-engineer --secret "$UC_AUTOMATION_SA_SECRET"
# In cloud the secret comes from a secret manager / Vault, or is eliminated via
# Workload Identity Federation.
UC_AUTOMATION_SA_CLIENT_ID=sa-platform-automation
UC_AUTOMATION_SA_SECRET=set-by-vault

# Team-scoped service accounts (Phase 6). A Dagster job tagged `team: <name>`
# runs as the team SA `sa-team-<name>` (CONVENTION), so Unity Catalog enforces
# THAT team's grants. There is NO team->SA env map: declare the team's
# `service_account.persona` in infra/iam/personas.yaml and the IAM reconciler
# auto-provisions the Keycloak client + Vault secret + UC grants. The SA secret
# is read from Vault at runtime (secret/platform/sa/sa-team-<name>).

# ------------------------------------------------------------
# Superset (visualization) -- Keycloak SSO + per-user identity forwarding to
# Spark Connect: each logged-in user's Keycloak token is exchanged for a UC
# token and set as the per-session catalog token, so UC enforces RBAC per user.
# ------------------------------------------------------------
SUPERSET_VERSION=4.1.1
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=set-by-vault
# Change this in any non-local deployment.
SUPERSET_SECRET_KEY=set-by-vault
# OIDC client for Superset SSO (must match infra/keycloak/realm-export.json).
SUPERSET_OIDC_CLIENT_ID=superset
SUPERSET_OIDC_CLIENT_SECRET=set-by-vault
# Browser-reachable URLs (host side) for the OAuth redirect dance.
KEYCLOAK_BROWSER_BASE=https://keycloak.localtest.me
SUPERSET_PUBLIC_BASE=https://superset.localtest.me

# ------------------------------------------------------------
# JupyterHub (hosted notebooks) -- Keycloak SSO + per-user Unity Catalog identity.
# Log in at http://localhost:8000 with a Keycloak user (e.g. analyst/analyst);
# uc_notebook.uc_session() runs Spark Connect as THAT user. Must match the
# 'jupyterhub' client in infra/keycloak/realm-export.json.
# ------------------------------------------------------------
JUPYTERHUB_OIDC_CLIENT_ID=jupyterhub
JUPYTERHUB_OIDC_CLIENT_SECRET=set-by-vault
JUPYTERHUB_PUBLIC_BASE=https://jupyter.localtest.me
# Encrypts stored per-user auth_state (Keycloak tokens). Generate: openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=set-by-vault

# ------------------------------------------------------------
# Dagster UI access (oauth2-proxy in front of Dagster OSS, which has no auth).
# Only personas with the data-engineer / platform-admin realm role may enter.
# Must match the 'dagster' client in infra/keycloak/realm-export.json.
# ------------------------------------------------------------
DAGSTER_OIDC_CLIENT_SECRET=set-by-vault
DAGSTER_PUBLIC_BASE=https://dagster.localtest.me
# oauth2-proxy cookie signing secret. Generate: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=set-by-vault

# ------------------------------------------------------------
# Spark Connect compute edge auth (pre-shared bearer token).
# The Spark Connect server (:15002) REQUIRES this token on every RPC
# (spark.connect.authenticate.token). Cross-container clients (Dagster, dbt,
# Jupyter) reach it via the TLS-terminating gRPC proxy `spark-connect:15003`,
# because PySpark only allows token auth to a non-localhost host over TLS.
# Host-local dev can instead use  sc://localhost:15002/;token=<this>  directly.
# Rotate for any real deploy.
# ------------------------------------------------------------
SPARK_CONNECT_TOKEN=set-by-vault
